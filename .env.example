# 🔧 Configuration du Projet CAMTEL
# Plateforme de Gestion et d'Analyse des Consommations de Carburant
# 
# ⚠️ IMPORTANT: Ne jamais commiter le fichier .env avec les vraies valeurs!
# Copie ce fichier en .env et remplis avec tes données

# =====================================
# 🤖 Configuration Gemini (Pour développement)
# =====================================
GEMINI_API_KEY=AIza_YOUR_API_KEY_HERE
GEMINI_MODEL=gemini-pro

# =====================================
# 🔐 Django Backend Configuration
# =====================================

# Base de données PostgreSQL
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=carburflow_db
DATABASE_USER=carburflow_user
DATABASE_PASSWORD=secure_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Django Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS (Cross-Origin Resource Sharing)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# =====================================
# 🔑 Authentification
# =====================================

# JWT Tokens
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# PIN Admin (pour backdoor si besoin)
ADMIN_PIN=1234

# =====================================
# 📱 React Frontend Configuration
# =====================================

# URL de l'API Backend
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_API_TIMEOUT=30000

# Mode développement
REACT_APP_DEBUG=true

# =====================================
# 📬 Notifications - Telegram Bot
# =====================================

# Générer un token: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Chat ID de l'admin (où envoyer les notifications)
# Tu peux trouver ton chat ID avec le bot: https://t.me/getidsbot
TELEGRAM_ADMIN_CHAT_ID=123456789

# Activer/désactiver les notifications
TELEGRAM_NOTIFICATIONS_ENABLED=True

# =====================================
# 📱 Notifications - SMS (Optionnel avec Twilio)
# =====================================

# Twilio Configuration (si tu utilises SMS)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Numéro de téléphone de l'admin (pour SMS)
ADMIN_PHONE_NUMBER=+237000000000

# Activer/désactiver les SMS
SMS_NOTIFICATIONS_ENABLED=False

# =====================================
# ⏱️ Tâches planifiées (Celery / APScheduler)
# =====================================

# Broker pour Celery (Redis ou RabbitMQ)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Intervalle de vérification de la consommation électrique (en secondes)
ELECTRICITY_CHECK_INTERVAL=3600  # 1 heure

# Seuils d'alerte
FUEL_CONSUMPTION_VARIANCE_THRESHOLD=20  # % d'écart acceptable
ELECTRICITY_ANOMALY_THRESHOLD=50  # % de variation

# =====================================
# 📊 Logging
# =====================================

# Niveau de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Chemin du fichier de log
LOG_FILE=logs/app.log

# =====================================
# 🌐 Déploiement Production
# =====================================

# Environment
ENVIRONMENT=development  # development, staging, production

# URLs de production (remplacer en prod)
PRODUCTION_BACKEND_URL=https://api.carburflow.com
PRODUCTION_FRONTEND_URL=https://carburflow.com

# Email pour notifications (optionnel)
ADMIN_EMAIL=admin@carburflow.com

# =====================================
# 🔐 Security (Production uniquement)
# =====================================

# HTTPS
SECURE_SSL_REDIRECT=False  # True en production
SESSION_COOKIE_SECURE=False  # True en production
CSRF_COOKIE_SECURE=False  # True en production

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=0  # 31536000 en production
SECURE_HSTS_INCLUDE_SUBDOMAINS=False  # True en production

# =====================================
# 📦 Services externes
# =====================================

# AWS S3 (si tu utilises S3 pour les fichiers)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=eu-west-1

# =====================================
# 🧪 Testing
# =====================================

# Utiliser une DB de test
USE_TEST_DATABASE=False

# =====================================
# 💬 Support & Debugging
# =====================================

# Token pour les requests de test
TEST_AUTH_TOKEN=test-token-123

# Mode verbose (pour debugging)
VERBOSE_LOGGING=True

# =====================================
# 📝 Notes
# =====================================

# Pour PostgreSQL avec Docker:
# docker run --name carburflow-db \
#   -e POSTGRES_DB=carburflow_db \
#   -e POSTGRES_USER=carburflow_user \
#   -e POSTGRES_PASSWORD=secure_password_here \
#   -p 5432:5432 \
#   -d postgres:15

# Pour créer un bot Telegram:
# 1. Ouvre https://t.me/BotFather
# 2. Tape /start puis /newbot
# 3. Suis les instructions
# 4. Copie le token généré ici

# Pour Twilio (SMS):
# 1. Crée un compte sur https://www.twilio.com
# 2. Copie Account SID et Auth Token
# 3. Achète un numéro Twilio

# Variables importantes pour le développement:
# - DATABASE_URL (alternative au DATABASE_* séparés)
# - REDIS_URL (si tu utilises Redis)
# - SENTRY_DSN (pour error tracking, optionnel)
