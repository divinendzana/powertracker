# ─────────────────────────────────────────────
# CAMTEL PowerTracker - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ─────────────────────────────────────────────

# ─────────── Django ───────────
DEBUG=True
SECRET_KEY='django-insecure-your-secret-key-here'
ALLOWED_HOSTS=localhost,127.0.0.1

# ──── Base de données PostgreSQL ────
DB_NAME=powertracker_db
DB_USER=powertracker_user
DB_PASSWORD=your_strong_password_here
DB_HOST=localhost
DB_PORT=5432

# ──── JWT ────
JWT_SECRET_KEY='your-jwt-secret-key-min-256-bits'
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# ──── CORS ────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ──── Celery / Redis ────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ──── Telegram ────
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id

# ──── Sécurité production ────
DEBUG=False
SECURE_SSL_REDIRECT=true
ENVIRONMENT=production
LOG_LEVEL=INFO